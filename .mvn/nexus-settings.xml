<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings used by the Jenkins pipeline (mvn -s .mvn/nexus-settings.xml ...).

  Every dependency and plugin download goes through the Nexus proxy of Maven Central.
  (Build artifacts are uploaded to maven-releases by the Jenkins nexusArtifactUploader step, not by Maven.)

  No secrets are stored here: NEXUS_USR / NEXUS_PSW are injected by Jenkins from the
  'nexus-creds' credential (environment { NEXUS = credentials('nexus-creds') }).
-->
<settings>

  <servers>
    <!-- Credentials for downloading through the mirror below (ids must match) -->
    <server>
      <id>nexus</id>
      <username>${env.NEXUS_USR}</username>
      <password>${env.NEXUS_PSW}</password>
    </server>
  </servers>

  <mirrors>
    <mirror>
      <id>nexus</id>
      <name>Nexus proxy of Maven Central</name>
      <mirrorOf>*</mirrorOf>
      <url>http://192.168.1.11:8081/repository/maven-central/</url>
    </mirror>
  </mirrors>

</settings>
