<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppressions, used by the "OWASP Dependency-Check (SCA)" Jenkins stage.
  Only suppress confirmed false positives or accepted risks, and always say why. The HTML report
  has a "suppress" button next to each finding that generates the entry. Example:

  <suppress until="2027-01-01Z">
    <notes>CVE-XXXX-YYYY: not exploitable, the affected API is not used by the application</notes>
    <packageUrl regex="true">^pkg:maven/org\.example/example-lib@.*$</packageUrl>
    <cve>CVE-XXXX-YYYY</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <suppress>
    <notes>False positive: CVE-2022-31691 affects the Spring Tools 4 IDE / VSCode extensions
      (vmware:spring_boot_tools), not the spring-boot-devtools library. It is matched only via the
      CPE name. devtools is also an optional dependency and is not packaged in the runnable jar.</notes>
    <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring-boot-devtools@.*$</packageUrl>
    <cve>CVE-2022-31691</cve>
  </suppress>
</suppressions>
